pragma language_version >= 0.23;

import CompactStandardLibrary;

// ============================================================================
// Public Ledger State - Stored On Midnight Blockchain
// ============================================================================
export ledger totalCardsIssued: Uint<64>;
export ledger totalValueRedeemed: Uint<64>;
export ledger totalValueRefunded: Uint<64>;
export ledger totalTransfersCount: Uint<64>;
export ledger activeCommitmentsCount: Uint<64>;
export ledger lastCommitment: Bytes<32>;

// ============================================================================
// Circuit 1: Issue Gift Card
// The merchant / issuer calls this circuit with a card commitment hash and public face value.
// ============================================================================
export circuit issueCard(cardCommitment: Bytes<32>, cardValue: Uint<64>): [] {
    totalCardsIssued = (totalCardsIssued + 1) as Uint<64>;
    activeCommitmentsCount = (activeCommitmentsCount + 1) as Uint<64>;
    lastCommitment = disclose(cardCommitment);
}

// ============================================================================
// Circuit 2: Redeem Gift Card Confidentially
// Verifies card redemption and updates public ledger stats without disclosing recipient private secret PIN.
// ============================================================================
export circuit redeemCard(
    cardCommitment: Bytes<32>,
    cardValue: Uint<64>,
    claimerHash: Bytes<32>
): [] {
    totalValueRedeemed = (totalValueRedeemed + disclose(cardValue)) as Uint<64>;
    if (activeCommitmentsCount > 0) {
        activeCommitmentsCount = (activeCommitmentsCount - 1) as Uint<64>;
    }
}

// ============================================================================
// Circuit 3: Transfer / Re-Gift Card Confidentially (August Challenge Feature)
// Allows a cardholder to transfer voucher ownership to a new recipient with a fresh commitment
// without revealing the old or new owner's identity on-chain.
// ============================================================================
export circuit transferCardOwnership(
    oldCommitment: Bytes<32>,
    newCommitment: Bytes<32>
): [] {
    totalTransfersCount = (totalTransfersCount + 1) as Uint<64>;
    lastCommitment = disclose(newCommitment);
}

// ============================================================================
// Circuit 4: Refund / Void Expired Card (August Challenge Feature)
// Allows the merchant to clawback / void unredeemed expired cards using merchant authentication proof.
// ============================================================================
export circuit refundExpiredCard(
    cardCommitment: Bytes<32>,
    cardValue: Uint<64>,
    merchantAuthHash: Bytes<32>
): [] {
    totalValueRefunded = (totalValueRefunded + disclose(cardValue)) as Uint<64>;
    if (activeCommitmentsCount > 0) {
        activeCommitmentsCount = (activeCommitmentsCount - 1) as Uint<64>;
    }
}
